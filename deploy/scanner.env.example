# Scanner secrets — copy to deploy/scanner.env and fill in. Never commit scanner.env.

# Shared secret between the dashboard and the scanner (any long random string).
# Generate: openssl rand -base64 32
SCANNER_API_KEY=

# Daily bars for the scan universe. Free: https://twelvedata.com
TWELVE_DATA_API_KEY=
TWELVE_DATA_REQUESTS_PER_MINUTE=8

# Claude explanations in the AI Insights panel. https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Which stocks to scan: a comma list, or research81 for the 81-stock research universe.
SCANNER_UNIVERSE=research81
LOG_LEVEL=info
