# Dashboard secrets — copy to deploy/web.env and fill in. Never commit web.env.

# --- Market data (required) ---
# Real-time quotes, NEWS and symbol search. Free: https://finnhub.io/register
FINNHUB_API_KEY=
# Chart candles. Free: https://twelvedata.com (8 req/min, 800/day per key)
TWELVE_DATA_API_KEY=
# Use a different Twelve Data key than the scanner if you can; otherwise keep this ≤ 4.
TWELVE_DATA_RPM=6

# --- Scanner (required) — must equal SCANNER_API_KEY in scanner.env ---
AI_SCANNER_API_KEY=

# --- Your site ---
PUBLIC_BASE_URL=https://yourdomain.com
# Passphrase that turns YOUR browser into the owner (email/Telegram copies). 12+ chars.
OWNER_KEY=

# --- Push notifications (phone/desktop) — generate with: cd frontend && npm run vapid ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Email to you (optional). Gmail: turn on 2-Step Verification, create an App Password ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=

# --- Telegram to you (optional). Token from @BotFather; chat id from @userinfobot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
