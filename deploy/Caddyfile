{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# flush_interval -1 keeps the live-price stream (Server-Sent Events) unbuffered.
	reverse_proxy web:3000 {
		flush_interval -1
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
