{
  "name": "ai-trading-bot-backend",
  "version": "0.1.0",
  "description": "AI-assisted stock market research and paper-trading platform",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node src/app.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "download-data": "ts-node src/scripts/downloadHistoricalData.ts",
    "validate-data": "ts-node src/scripts/validateData.ts",
    "analyze-stock": "ts-node src/scripts/analyzeStock.ts",
    "generate-signals": "ts-node src/scripts/generateSignals.ts",
    "analyze-signal-ai": "ts-node src/scripts/analyzeSignalWithAI.ts",
    "run-backtest": "ts-node src/scripts/runBacktest.ts",
    "download-universe": "ts-node src/scripts/downloadUniverse.ts",
    "download-second-universe": "ts-node src/scripts/downloadSecondUniverse.ts",
    "run-expanded-backtest": "ts-node src/scripts/runExpandedBacktest.ts",
    "run-momentum-diagnostics": "ts-node src/scripts/runMomentumDiagnostics.ts",
    "run-score-calibration": "ts-node src/scripts/runScoreCalibrationExperiment.ts",
    "run-experiment-2": "ts-node src/scripts/runExperiment2CrossUniverse.ts",
    "download-holdout-pre2020": "ts-node src/scripts/downloadHoldoutPre2020.ts",
    "run-experiment-3": "ts-node src/scripts/runExperiment3TemporalHoldout.ts",
    "run-experiment-4": "ts-node src/scripts/runExperiment4NeutralQualityFilter.ts",
    "run-experiment-5": "ts-node src/scripts/runExperiment5BullishMomentumGate.ts",
    "run-experiment-6": "ts-node src/scripts/runExperiment6MinusDI14Replication.ts",
    "paper-trade": "ts-node src/scripts/runPaperTradingTick.ts",
    "ibkr-paper-trade": "ts-node src/scripts/runIBKRPaperTrading.ts",
    "ibkr-day-trade": "ts-node src/scripts/runIBKRDayTrading.ts",
    "ibkr-status": "ts-node src/scripts/checkIBKRStatus.ts",
    "download-intraday-data": "ts-node src/scripts/downloadIntradayData.ts",
    "run-intraday-backtest": "ts-node src/scripts/runIntradayBacktest.ts",
    "analyze-intraday-trade-quality": "ts-node src/scripts/analyzeIntradayTradeQuality.ts",
    "analyze-intraday-entry-quality-features": "ts-node src/scripts/analyzeIntradayEntryQualityFeatures.ts",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "serve": "TS_NODE_TRANSPILE_ONLY=1 ts-node -r tsconfig-paths/register src/server/index.ts"
  },
  "keywords": [
    "stocks",
    "trading",
    "technical-analysis",
    "quantitative",
    "backtesting",
    "paper-trading"
  ],
  "author": "AI Trading Bot Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@stoqey/ib": "^1.6.7",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-cache": "^5.1.2",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.2"
  }
}
