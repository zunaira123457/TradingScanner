# Market Data Provider Configuration
MARKET_DATA_PROVIDER=twelve-data
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
# Free tier is 8 requests/minute; raise this to match a paid plan.
TWELVE_DATA_REQUESTS_PER_MINUTE=8

# Fallback providers (optional)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Database Configuration
DATABASE_URL=sqlite:///./data/trading_bot.db
DATABASE_TYPE=sqlite

# API Configuration
API_PORT=3000
API_HOST=localhost
NODE_ENV=development

# Cache Configuration
CACHE_DIR=./data/cache
CACHE_MAX_AGE_HOURS=24

# Stock Universe Filters
MIN_PRICE=1.0
MIN_AVG_VOLUME=100000
MIN_AVG_DOLLAR_VOLUME=1000000
MIN_HISTORY_DAYS=252

# Data Download Configuration
DATA_START_DATE=2020-01-01
DATA_BATCH_SIZE=50
DATA_RETRY_ATTEMPTS=3

# Logging
LOG_LEVEL=info

# AI Configuration (Claude API) — optional. The Phase 5 AI explanation layer
# degrades to a deterministic fallback if this is unset; nothing else in the
# app depends on it.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5
AI_ANALYSIS_TIMEOUT_MS=60000

# Backtesting Configuration
BACKTEST_SLIPPAGE_BPS=5
BACKTEST_COMMISSION_BPS=2
BACKTEST_MAX_POSITIONS=10
BACKTEST_MAX_SECTOR_EXPOSURE_PCT=30
BACKTEST_MAX_STOCK_EXPOSURE_PCT=10

# Paper Trading Configuration (Phase 7 — simulation only, never a real broker)
INITIAL_PORTFOLIO_VALUE=10000
MAX_RISK_PER_TRADE_PCT=1
# MAX_PORTFOLIO_RISK_PCT and MAX_DRAWDOWN_PCT are read into config but not
# yet wired into anything — neither maps onto a concept Backtester/Portfolio
# currently compute (no aggregate-risk calc, no drawdown kill-switch exists
# in the engine). Left here as scaffolding for a future addition rather than
# silently repurposed to mean something else.
MAX_PORTFOLIO_RISK_PCT=5
MAX_DRAWDOWN_PCT=20

# IBKR (TWS/IB Gateway) — real broker connection for PAPER account order
# execution. This connects to whatever account TWS is logged into; verify
# TWS is on the paper trading account before running this integration.
# TWS default paper port is 7497 (IB Gateway paper is 4002).
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
# Kept deliberately conservative and separate from MAX_RISK_PER_TRADE_PCT
# (which only affects the internal Backtester-based simulation) so tuning
# real paper-order size never silently changes backtest behavior.
IBKR_MAX_RISK_PER_TRADE_PCT=0.25
IBKR_MAX_POSITION_VALUE_USD=5000

# IBKR Day Trading — intraday signals (src/strategies/intraday), trailing-
# stop bracket orders, one long-running process polling during market hours.
# Trade sizing here is intentionally separate from IBKR_MAX_*_PCT/USD above
# (swing paper trading) for the same reason those are separate from
# MAX_RISK_PER_TRADE_PCT: tuning one never silently changes the other.
IBKR_DAY_TRADING_START_TIME_CST=08:30
IBKR_DAY_TRADING_END_TIME_CST=15:00
IBKR_DAY_TRADING_POLL_INTERVAL_MINUTES=5
IBKR_DAY_TRADING_MAX_TRADES_PER_DAY=5
IBKR_DAY_TRADING_MAX_RISK_PER_TRADE_PCT=0.5
IBKR_DAY_TRADING_MAX_POSITION_VALUE_USD=2000
# Stop-loss leg trails price by this percent once placed (IBKR TRAIL order).
IBKR_DAY_TRADING_TRAIL_PERCENT=1.0
# How many of the cached top-liquid-stocks universe to scan each poll cycle
# — kept low relative to the swing pipeline's 500 to respect IBKR's
# historical-data request pacing.
IBKR_DAY_TRADING_UNIVERSE_SIZE=50

# Scanner HTTP API (npm run serve) — consumed by the Next.js dashboard in ../frontend
SCANNER_PORT=4000
# Required outside local dev: the dashboard sends this as `x-api-key`.
SCANNER_API_KEY=
# Comma-separated tickers, or `research81` for the 81-stock backtest universe.
SCANNER_UNIVERSE=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AMD,NFLX,JPM,AVGO,COST
