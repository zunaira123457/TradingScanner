# All keys are server-side only (no NEXT_PUBLIC_ prefix) — the browser never sees them.

# Real-time quotes, news and symbol search. Free key: https://finnhub.io/register
# Without it, quotes fall back to Twelve Data at a much slower cadence.
FINNHUB_API_KEY=

# OHLCV candles for all chart timeframes (and quote fallback). Free key: https://twelvedata.com
TWELVE_DATA_API_KEY=

# The AI scanner API from ../backend (`npm run serve`).
AI_SCANNER_BASE_URL=http://localhost:4000
# Must match SCANNER_API_KEY in backend/.env
AI_SCANNER_API_KEY=

# Optional: per-instance upstream request budgets (requests/minute).
# Twelve Data's free 8/min is per key — keep this lower if the scanner shares the key.
# FINNHUB_RPM=50
# TWELVE_DATA_RPM=6

# ---- Notifications (see ../DEPLOY.md) ----
# Where alerts + push subscriptions are stored (JSON file).
# DATA_DIR=.data
# Used for links in emails / Telegram messages.
PUBLIC_BASE_URL=http://localhost:3000
# Passphrase that turns your browser into the owner (gets email/Telegram copies). 12+ chars.
OWNER_KEY=
# Web push — generate with `npm run vapid`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Email to the owner (Gmail: smtp.gmail.com / 465 / your address / an App Password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=
# NOTIFY_EMAIL_FROM="Trading Desk <you@example.com>"
# Telegram to the owner (@BotFather token, @userinfobot chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
